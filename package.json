{
  "name": "garlic",
  "productName": "Garlic",
  "version": "1.2.3",
  "description": "Garlic: convert, edit and organize files from a small wheel that opens next to any file.",
  "main": "src/main/index.js",
  "license": "MIT",
  "private": true,
  "author": "Sltcrd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sltcrd/garlic.git"
  },
  "homepage": "https://github.com/Sltcrd/garlic#readme",
  "bugs": {
    "url": "https://github.com/Sltcrd/garlic/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "electron .",
    "start:hidden": "electron . --hidden",
    "lint": "eslint .",
    "check": "node scripts/check.js",
    "test": "node scripts/run-tests.js unit",
    "test:e2e": "node scripts/run-tests.js e2e",
    "verify": "npm run lint && npm run check && npm test && npm run test:e2e",
    "audit:prod": "npm audit --omit=dev",
    "notices": "node scripts/notices.js",
    "icons": "electron scripts/make-icons.js",
    "i18n:harvest": "node scripts/i18n-harvest.js --out i18n-keys.json",
    "screenshots": "node scripts/screenshots.js",
    "package": "node scripts/package.js",
    "package:zip": "node scripts/package.js --zip"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "ffmpeg-static": "^5.3.0",
    "heic2any": "^0.0.4",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "marked": "^18.1.1",
    "pdfjs-dist": "^6.4.299",
    "uiohook-napi": "^1.5.5",
    "utif": "^3.1.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^44.9.3",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "pptxgenjs": "^4.0.1"
  },
  "overrides": {
    "sprintf-js": "^1.1.3"
  },
  "bin": {
    "garlic": "bin/garlic.js"
  }
}
